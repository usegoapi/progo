# =============================================================
# GO-API · Variáveis do docker-compose
# Copie para .env e preencha. NUNCA versione o arquivo .env.
# =============================================================

# ---------- Portas publicadas ----------
API_PORT=4000
PANEL_PORT=3010
# URL pública da API (navegador, webhooks de retorno do Chatwoot)
PUBLIC_API_URL=http://localhost:4000

# ---------- Banco ----------
POSTGRES_USER=goapi
POSTGRES_DB=goapi
# Gere com: openssl rand -hex 24
POSTGRES_PASSWORD=

# ---------- Segurança ----------
# Gere com: openssl rand -hex 32
JWT_SECRET=
APP_SECRET=
ADMIN_EMAIL=admin@goapi.local
# Vazio = senha aleatória exibida uma única vez no log da API
ADMIN_PASSWORD=
ALLOW_REGISTRATION=false
# true = bloqueia webhooks/integrações apontando para redes internas (recomendado se multiusuário)
BLOCK_PRIVATE_NETWORK=false
# Restrinja em produção, ex: https://painel.suaempresa.com
CORS_ORIGINS=

# ---------- Anti-ban ----------
SEND_MIN_INTERVAL_MS=900
SEND_JITTER_MS=600
SEND_MAX_PER_MINUTE=40
TYPING_SIMULATION=true

# ---------- Whitelabel (runtime, sem rebuild) ----------
BRAND_NAME=GO-API
BRAND_LOGO_URL=/img/logosite.png
BRAND_ICON_URL=/img/icone.png
BRAND_PRIMARY_COLOR=#eaa800
BRAND_TAGLINE=
BRAND_SUPPORT_URL=
BRAND_COPYRIGHT=

# ---------- Versão das imagens (ghcr.io/usegoapi) ----------
# latest = última versão da main. Para fixar: ex. GOAPI_VERSION=2.0.0 ou sha-381c378
GOAPI_VERSION=latest
