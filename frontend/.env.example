# URL da API acessível pelo NAVEGADOR do usuário
API_URL=http://localhost:4000

# ===================== Whitelabel =====================
# Todas as opções são lidas em runtime: troque e reinicie o container, sem rebuild.
BRAND_NAME=GO-API
# Caminho em /public ou URL absoluta
BRAND_LOGO_URL=/img/logosite.png
BRAND_ICON_URL=/img/icone.png
# Cor principal (hex). O contraste do texto sobre ela é calculado automaticamente.
BRAND_PRIMARY_COLOR=#eaa800
BRAND_TAGLINE=Gerencie suas instâncias de WhatsApp API, acompanhe mensagens e integre com suas ferramentas favoritas.
# Link do menu "Suporte" (http(s):// ou mailto:). Vazio = oculto.
BRAND_SUPPORT_URL=
# Texto do rodapé. Vazio = "© <ano> <BRAND_NAME>. Todos os direitos reservados."
BRAND_COPYRIGHT=
