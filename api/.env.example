# ===================== Banco =====================
DATABASE_URL=postgresql://goapi:goapi@localhost:5432/goapi

# ===================== Servidor =====================
PORT=3001
NODE_ENV=development
# URL pela qual serviços externos (ex: Chatwoot) alcançam esta API
PUBLIC_API_URL=http://localhost:3001
# Origens permitidas no CORS (vírgula). Vazio = qualquer origem.
CORS_ORIGINS=
LOG_LEVEL=log

# ===================== Segurança =====================
# OBRIGATÓRIO em produção: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Segredo para tokens de callback (Chatwoot). Opcional: derivado do JWT_SECRET.
APP_SECRET=
# Administrador inicial (criado apenas se não existir). Sem senha, uma é gerada e exibida no log.
ADMIN_EMAIL=admin@goapi.local
ADMIN_PASSWORD=
ADMIN_RESET_PASSWORD=false
# Cadastro público de novos usuários
ALLOW_REGISTRATION=false
# Bloqueia chamadas de saída para redes internas (SSRF). Ative se a API for multiusuário/pública.
BLOCK_PRIVATE_NETWORK=false
THROTTLE_LIMIT=600
THROTTLE_TTL_MS=60000
MAX_INSTANCES_PER_USER=50

# ===================== WhatsApp =====================
SESSIONS_DIR=sessions
WA_BROWSER_NAME=GO-API
RESTORE_SESSIONS_ON_BOOT=true

# ===================== Anti-ban (fila de envio) =====================
SEND_MIN_INTERVAL_MS=900
SEND_JITTER_MS=600
SEND_MAX_PER_MINUTE=40
SEND_QUEUE_LIMIT=500
TYPING_SIMULATION=true

# ===================== Mídia =====================
MEDIA_MAX_MB=32
BODY_LIMIT=25mb
FFMPEG_PATH=
